# CatalogService Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogservice
DB_USERNAME=svc_catalog_dba
DB_PASSWORD=svc_catalog_dba

# =============================================================================
# RabbitMQ Messaging Configuration
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=svc_catalog_rmq
RABBITMQ_PASSWORD=svc_catalog_rmq

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Messaging Toggle
# Injected by Helm configmap in deployed environments (sit/uat/prd).
# Set to true here only if running the full stack locally via compose.container.yaml.
# Maps to: iqkv.messaging.rabbitmq.enabled
# =============================================================================
MESSAGING_ENABLED=false

POSTGRES_DB=catalogservice
POSTGRES_USER=svc_catalog_dba
POSTGRES_PASSWORD=svc_catalog_dba
