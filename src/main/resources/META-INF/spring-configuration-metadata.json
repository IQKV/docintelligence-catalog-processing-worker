{
    "groups": [
        {
            "name": "iqkv.db",
            "description": "Intermediary database connection properties. Values are composed into spring.datasource by profile ymls."
        },
        {
            "name": "iqkv.rabbitmq",
            "description": "Intermediary RabbitMQ connection properties. Values are composed into spring.rabbitmq by profile ymls."
        },
        {
            "name": "iqkv.messaging",
            "description": "Messaging infrastructure configuration."
        },
        {
            "name": "iqkv.messaging.rabbitmq",
            "type": "com.iqkv.docintelligence.catalogprocessingworker.infrastructure.config.MessagingConfigurationProperties",
            "sourceType": "com.iqkv.docintelligence.catalogprocessingworker.infrastructure.config.MessagingConfigurationProperties",
            "description": "RabbitMQ messaging toggles. 'enabled' drives @ConditionalOnProperty in RabbitMQConfig."
        }
    ],
    "properties": [
        {
            "name": "iqkv.db.host",
            "type": "java.lang.String",
            "description": "Database server hostname.",
            "defaultValue": "localhost"
        },
        {
            "name": "iqkv.db.port",
            "type": "java.lang.Integer",
            "description": "Database server port.",
            "defaultValue": 5432
        },
        {
            "name": "iqkv.db.name",
            "type": "java.lang.String",
            "description": "Database name.",
            "defaultValue": "catalogservice"
        },
        {
            "name": "iqkv.db.username",
            "type": "java.lang.String",
            "description": "Database username.",
            "defaultValue": "svc_catalog_dba"
        },
        {
            "name": "iqkv.db.password",
            "type": "java.lang.String",
            "description": "Database password.",
            "defaultValue": "svc_catalog_dba"
        },
        {
            "name": "iqkv.rabbitmq.host",
            "type": "java.lang.String",
            "description": "RabbitMQ broker hostname.",
            "defaultValue": "localhost"
        },
        {
            "name": "iqkv.rabbitmq.port",
            "type": "java.lang.Integer",
            "description": "RabbitMQ broker AMQP port.",
            "defaultValue": 5672
        },
        {
            "name": "iqkv.rabbitmq.username",
            "type": "java.lang.String",
            "description": "RabbitMQ username.",
            "defaultValue": "svc_catalog_rmq"
        },
        {
            "name": "iqkv.rabbitmq.password",
            "type": "java.lang.String",
            "description": "RabbitMQ password.",
            "defaultValue": "svc_catalog_rmq"
        },
        {
            "name": "iqkv.messaging.rabbitmq.enabled",
            "type": "java.lang.Boolean",
            "description": "Enables RabbitMQ messaging. When false, RabbitMQConfig is skipped. Defaults to false for local safety; the Helm chart configmap sets MESSAGING_ENABLED per environment (sit/uat/prd).",
            "defaultValue": false
        }
    ],
    "hints": [
        {
            "name": "iqkv.messaging.rabbitmq.enabled",
            "values": [
                {
                    "value": true,
                    "description": "Enable RabbitMQ — used by local, sit, uat and prd profiles."
                },
                {
                    "value": false,
                    "description": "Disable RabbitMQ — base profile default."
                }
            ]
        }
    ]
}
